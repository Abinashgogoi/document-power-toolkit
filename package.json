{
  "name": "document-power-toolkit",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "dev": "npm run prepare:ocr && vite --host 0.0.0.0",
    "build": "npm run prepare:ocr && tsc -b && vite build && node scripts/build-cloudflare.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:ocr": "npm run prepare:ocr && node scripts/verify-ocr.mjs",
    "test:browser": "node scripts/build-e2e.mjs && node scripts/browser-smoke.mjs",
    "test:watch": "vitest",
    "check": "tsc -b --pretty false",
    "test:auth-gate": "npm run build && node scripts/auth-gate-smoke.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/asm": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
